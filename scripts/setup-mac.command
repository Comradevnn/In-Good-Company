#!/usr/bin/env bash
# One-time (re-runnable) setup: clones and builds the sibling Recryption
# library, installs backend + mobile dependencies, and creates backend/.env
# with a fresh DOC_PEPPER if one doesn't exist yet. Skips anything already done.
. "$(dirname "$0")/_common.sh"

echo "== Node $(node -v), npm $(npm -v)"

if [ ! -d "$RECRYPTION_DIR" ]; then
  echo "== Cloning Recryption into $RECRYPTION_DIR"
  git clone https://github.com/Comradevnn/recryption.git "$RECRYPTION_DIR"
fi
if [ ! -f "$RECRYPTION_DIR/dist/index.js" ]; then
  echo "== Building Recryption"
  (cd "$RECRYPTION_DIR" && npm install --no-fund --no-audit && npm run build)
fi

echo "== Installing backend dependencies"
(cd "$BACKEND_DIR" && npm install --no-fund --no-audit)

# backend/data/ is gitignored and better-sqlite3 won't create the directory
# for app.db itself, so a fresh clone needs it made here.
mkdir -p "$BACKEND_DIR/data"

if [ -f "$BACKEND_DIR/.env" ]; then
  echo "== backend/.env already exists, leaving it alone"
else
  echo "== Creating backend/.env with a new DOC_PEPPER"
  (umask 077 && printf 'DOC_PEPPER=%s\n' "$(openssl rand -hex 32)" > "$BACKEND_DIR/.env")
fi

echo "== Installing mobile dependencies"
# --legacy-peer-deps: the lockfile was generated by an npm that tolerated
# react-native-web's optional react-dom peer; npm 11+ rejects it otherwise.
(cd "$MOBILE_DIR" && npm ci --legacy-peer-deps --no-fund --no-audit)

echo "== Setup complete"
